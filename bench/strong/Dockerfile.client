FROM golang:1.23-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY bench/strong/go.mod bench/strong/go.sum ./
RUN go mod download
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.35.2 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1
COPY proto/cache.proto ./cache.proto
RUN mkdir pb && protoc -I . \
    --go_out=pb --go_opt=paths=source_relative \
    --go_opt=Mcache.proto=cachebench/pb \
    --go-grpc_out=pb --go-grpc_opt=paths=source_relative \
    --go-grpc_opt=Mcache.proto=cachebench/pb cache.proto
COPY bench/strong/main.go ./main.go
COPY bench/strong/httpbench.go ./httpbench.go
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -o /work/cachebench ./main.go
RUN CGO_ENABLED=0 go build -trimpath -o /work/httpbench ./httpbench.go

FROM alpine:3.21
COPY --from=build /work/cachebench /usr/local/bin/cachebench
COPY --from=build /work/httpbench /usr/local/bin/httpbench
ENTRYPOINT ["/usr/local/bin/cachebench"]
